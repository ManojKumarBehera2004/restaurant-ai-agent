# ============================================================
# AI Restaurant Support & Operations Agent - Environment Configuration
# ============================================================

# App Settings
APP_NAME="AI Restaurant Support & Operations Agent"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# LLM Configuration
# Options: "gemini" (recommended) or "mock" (for offline dev/tests)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_TEMPERATURE=0.2
MAX_TOKENS=1024

# Database Configuration
# Uses SQLite for local dev; can be switched to postgresql://user:pass@localhost:5432/dbname
DATABASE_URL="sqlite:///./data/restaurant_ops.db"

# RAG & Vector Store Configuration
CHROMA_PERSIST_DIR="./data/chroma_db"
RAG_COLLECTION_NAME="restaurant_knowledge"
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.55

# Agent Limits & Guardrails
MAX_AGENT_ITERATIONS=5
ENABLE_GUARDRAILS=true
ENABLE_INJECTION_DETECTION=true
STRICT_CUSTOMER_ISOLATION=true

# Observability
LOG_LEVEL="INFO"
ENABLE_AUDIT_LOGGING=true

# Diagnostic Testing
SIMULATE_ORDER_SERVICE_OUTAGE=false
SIMULATE_LLM_TIMEOUT=false
